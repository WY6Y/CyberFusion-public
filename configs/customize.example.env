# Copy to customize.env and edit before deploy (do not commit customize.env).
# Source before running phase scripts:  set -a; source configs/customize.env; set +a

# Linux user that runs MMDVM/dashboard (Raspberry Pi OS default: pi)
HOTSPOT_USER=pi

# Hostname for the Pi
HOTSPOT_HOSTNAME=cyberfusion-hotspot

# Fallback AP (must match configs/hostapd.conf ssid=)
AP_SSID=CyberFusion-Hotspot
AP_PASSWORD=CHANGE_ME_HOTSPOT_PASSWORD

# Radio — must match mmdvmhost.ini and ysfgateway.ini
CALLSIGN=CHANGEME
DMR_ID=1234567
RX_FREQUENCY=446000000
TX_FREQUENCY=446000000
FREQ_MHZ=446.000

# Dashboard display (optional overrides)
SITE_TITLE=CYBERFUSION HOTSPOT
LOCAL_CALLSIGN=CHANGEME

# Info fields
LOCATION=Your City
LATITUDE=0.0
LONGITUDE=0.0

# Client WiFi (optional — or use dashboard / add-wifi-client.sh)
# WIFI_SSID=YourHomeWiFi
# WIFI_PSK=your_wifi_password